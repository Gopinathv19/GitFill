{
  "name": "gitfill",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:live": "LIVE_TESTS=1 vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "worker": "tsx scripts/worker.ts",
    "dev:all": "concurrently -n web,worker -c blue,green \"npm run dev\" \"npm run worker\"",
    "muse:check": "tsx scripts/muse-check.ts",
    "dev:local": "DATABASE_URL=pglite:./storage/pglite AUTH_MODE=stub next dev --turbopack",
    "db:migrate:local": "DATABASE_URL=pglite:./storage/pglite tsx scripts/migrate.ts",
    "ext:build": "cd extension && npm install && npm run compile",
    "ext:package": "cd extension && npm run package",
    "db:reset": "tsx scripts/reset-db.ts --yes && tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.62.0",
    "mermaid": "^11.17.2",
    "next": "15.5.4",
    "next-themes": "^0.4.6",
    "openai": "^7.45.1",
    "postgres": "^3.4.9",
    "pptxgenjs": "^4.0.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
