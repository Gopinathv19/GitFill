# Copy to deploy/.env.production (chmod 600, never commit). Read by docker compose for both
# variable substitution and the containers' environment.

# ── Compose ─────────────────────────────────────────────────────────────────────
# Host port nginx proxies to (bound to 127.0.0.1 only). Pick one the other app does not use.
GITFILL_PORT=3100
# Background workers; each runs one job (deck, handbook, video…) at a time with up to 6 GB.
GITFILL_WORKERS=2
# openssl rand -hex 24
POSTGRES_PASSWORD=

# ── App ─────────────────────────────────────────────────────────────────────────
APP_BASE_URL=https://gitfill.example.com
# openssl rand -hex 32, each
AUTH_SECRET=
TOKEN_ENCRYPTION_KEY=
# Real sign-in only in production (the stub demo user is for development).
AUTH_MODE=github
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_SCOPES=read:user user:email repo
# Fallback token for users who have not connected GitHub (public repositories only).
GITHUB_TOKEN=

# GitHub App that opens pull requests (README, .gitfill/docs, .gitfill/knowledge). Optional.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# One line with \n for newlines.
GITHUB_APP_PRIVATE_KEY=

# ── Models ──────────────────────────────────────────────────────────────────────
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
MUSE_USE_CONTRIBUTOR=false

# ── Retrieval (optional) ────────────────────────────────────────────────────────
MEMORA_BASE_URL=
MEMORA_API_TOKEN=

# ── Code search ─────────────────────────────────────────────────────────────────
GITFILL_SEARCH=agentic
# Cloned repositories live in the data volume (/data/repos); old ones are evicted past this size.
GIT_STORE_MAX_GB=40
GIT_STORE_MAX_REPO_MB=1500
