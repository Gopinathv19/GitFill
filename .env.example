# Copy to .env and fill in. Never commit .env.
# Minimum for a full local run: DATABASE_URL and MODEL_API_KEY. Everything else is optional.

# ── Database ────────────────────────────────────────────────────────────────────
# Neon (or any Postgres) connection string. Use a separate Neon branch for development.
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Or an embedded single-process database (no server needed; jobs then run inside the web app):
#   DATABASE_URL=pglite:./storage/pglite
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# ── Models (Meta Model API, https://dev.meta.ai) ────────────────────────────────
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
# "true" routes loop-heavy roles to the cheaper -contributor models.
# Meta may train on contributor-tier inputs: only enable for public demo repos.
MUSE_USE_CONTRIBUTOR=false

# ── Retrieval (Memora RAG pipeline, optional) ───────────────────────────────────
# GitFill indexes every analyzed repository commit in Memora and retrieves relevant code
# passages for questions and handbooks (hybrid search → MMR → reranking). Without these,
# agents fall back to literal search and the code graph.
# MEMORA_BASE_URL is the Memora backend (e.g. http://localhost:8000); MEMORA_API_TOKEN is an
# application credential created in the Memora console ("memora_…").
MEMORA_BASE_URL=
MEMORA_API_TOKEN=
# How long background jobs wait for a fresh index before continuing without it (ms).
MEMORA_INDEX_TIMEOUT_MS=150000

# ── GitHub ──────────────────────────────────────────────────────────────────────
# Repositories are read with each signed-in user's own GitHub account (OAuth below), so
# users get their own rate limit and their private repositories.
# GITHUB_TOKEN is only a fallback for users who have not connected GitHub: public repos,
# 5000 requests/hour instead of 60. A fine-grained token with public read access is enough.
GITHUB_TOKEN=

# ── App ─────────────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000

# Local directory for generated files (.pptx, PDF, previews). Created on demand.
ARTIFACT_STORAGE_PATH=./storage

# LibreOffice binary used to render slides (presentations only).
SOFFICE_PATH=soffice

# "true" runs queued jobs inside the web process instead of `npm run worker`.
# Automatic when DATABASE_URL starts with pglite:. Leave unset for Neon + worker.
INLINE_WORKER=

# ── Sign-in and GitHub OAuth ────────────────────────────────────────────────────
# AUTH_MODE=stub gives a one-click demo user (default in development); the demo user can
# still connect a GitHub account from Settings. AUTH_MODE=github makes GitHub the only way in.
# Both need a GitHub OAuth app (github.com → Settings → Developer settings → OAuth Apps)
# with callback URL <APP_BASE_URL>/api/auth/github/callback.
AUTH_MODE=stub
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Scopes requested at sign-in. "repo" grants read access to the user's private repositories
# (GitHub has no read-only private scope for OAuth apps; GitFill never writes).
GITHUB_OAUTH_SCOPES=read:user user:email repo
# 32+ random characters, e.g. `openssl rand -hex 32`. Required in production.
AUTH_SECRET=
# Encrypts users' GitHub tokens at rest (AES-256-GCM). 32+ characters, e.g. `openssl rand -hex 32`.
# Falls back to AUTH_SECRET; set a separate key in production so the two can be rotated independently.
TOKEN_ENCRYPTION_KEY=
